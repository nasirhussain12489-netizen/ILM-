# ==============================================================================
# ILM PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or configure these variables in Vercel Project Settings.
# NEVER commit real production secrets or credentials to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon / Cloud SQL)
# ------------------------------------------------------------------------------
# Option A: Full Connection String (Recommended for Vercel, Supabase, Neon)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require"
# POSTGRES_URL="postgresql://..."

# Option B: Individual Cloud SQL / PostgreSQL Connection Parameters
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="your-secure-sql-password"
SQL_DB_NAME="ilm_db"
SQL_SSL="true"

# ------------------------------------------------------------------------------
# 2. SUPABASE INTEGRATION (Tables, Storage & Sync)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ------------------------------------------------------------------------------
# 3. IMGBB IMAGE HOSTING (Permanent CDN for Posters & Photos)
# ------------------------------------------------------------------------------
IMGBB_API_KEY="your-imgbb-api-key"

