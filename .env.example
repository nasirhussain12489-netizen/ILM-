# ==============================================================================
# ILM PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or configure these variables in Vercel Project Settings.
# Pure PostgreSQL + Supabase Architecture (No Firebase Required).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon / Cloud SQL)
# ------------------------------------------------------------------------------
# Recommended for Vercel & Supabase:
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require"
# POSTGRES_URL="postgresql://..."

# Individual PostgreSQL Connection Parameters (Optional Fallback):
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="your-secure-sql-password"
SQL_DB_NAME="ilm_db"
SQL_SSL="true"

# ------------------------------------------------------------------------------
# 2. SUPABASE INTEGRATION (Tables, Storage & Sync)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://gmgdqwcnbkxqfskfuncs.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_diG86-3zLdM71WGxnn_Z4g_VE-msXQV"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ------------------------------------------------------------------------------
# 3. IMGBB IMAGE HOSTING (Permanent CDN for Posters & Photos)
# ------------------------------------------------------------------------------
IMGBB_API_KEY="a75a4b9ad34361c1648815fc4edd5a87"

# ------------------------------------------------------------------------------
# 4. SERVER SECURITY & APPLICATION HOSTING
# ------------------------------------------------------------------------------
SESSION_SECRET="your-strong-random-session-secret"
